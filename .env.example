# Database (PostgreSQL — Prisma 7 driver adapter reads this via prisma.config.ts / src/lib/prisma.ts)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Session signing key for auth cookies — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Public app URL, used to build links in emails and Stripe checkout redirects
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments (Stripe, test mode) — see docs/ARCHITECTURE.md "Payments"
# Get the secret key from Dashboard → Developers → API keys (test mode).
STRIPE_SECRET_KEY="sk_test_..."
# No public URL to receive real webhooks locally — either run
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` and use
# the secret it prints, or generate a local-only one for simulated-event
# testing: node -e "console.log('whsec_' + require('crypto').randomBytes(24).toString('hex'))"
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Not yet wired up — reserved for later phases ---

# Object storage (course thumbnails, videos, certificates, uploads)
# STORAGE_ENDPOINT=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
# STORAGE_BUCKET=""

# Email delivery (src/lib/email — currently logs to console instead of sending)
# EMAIL_API_KEY=""
# EMAIL_FROM_ADDRESS="hello@example.com"

# Analytics provider, if/when one is wired behind the analytics abstraction
# ANALYTICS_WRITE_KEY=""
